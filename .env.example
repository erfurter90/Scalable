# Copy this file to .env and fill in real values. Never commit the real .env file.

# --- Backend ---
# Local dev default: SQLite, zero setup. Switch to Postgres (e.g. via docker-compose) by
# changing this single value - all models/migrations are dialect-agnostic.
DATABASE_URL=sqlite:///./finanz_agent.db
# DATABASE_URL=postgresql+psycopg2://finanz_agent:finanz_agent@localhost:5432/finanz_agent

# Used to sign session/auth tokens. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme-generate-a-random-64-char-hex-string

# Optional. If unset, the AI assistant feature degrades gracefully (reports "not configured")
# instead of crashing. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# "live" calls real external APIs (CoinGecko, alternative.me). "mock" always uses deterministic
# fake data - useful for offline development.
MARKET_DATA_MODE=live

# Credentials for the single bootstrap user, used only by the create-user CLI script.
BOOTSTRAP_USERNAME=admin
BOOTSTRAP_PASSWORD=changeme

# --- Postgres (only used by docker-compose, not by local SQLite dev) ---
POSTGRES_USER=finanz_agent
POSTGRES_PASSWORD=changeme
POSTGRES_DB=finanz_agent

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
